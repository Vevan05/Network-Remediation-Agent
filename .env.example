# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Which agent the API's "Start an incident" button uses: heuristic (free) or llm
AGENT_KIND=heuristic

# Policy
ADAPTIVE_THRESHOLD=0.40

# Which risk formula is live: "v1" (no correctness signal) or "v2" (adds the
# rubric-consistency term and a context-aware blast radius). See README.md.
RISK_VERSION=v2

# Experiment assumptions - FREEZE before the real runs and report them in the paper
INJECT_SETTLE_S=2
RECOVERY_TIMEOUT_S=10
HUMAN_REVIEW_DELAY_S=45
MANUAL_FIX_PENALTY_S=180
OPERATOR_CATCH_RATE=0.90

# Operator review load under the adaptive policy (1.0 = every incident is reviewed
# by a human, as in full-human). Drives the alert-fatigue model.
ADAPTIVE_REVIEW_LOAD=0.25
